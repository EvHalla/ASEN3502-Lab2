e = 10e-6;
h = .001;

M = 1.5;

d1 = @(theta) (shock_residual(delta, M, theta + h) - shock_residual(delta, M, theta)) / h;
d2 = @(theta) shock_derivative(theta, M);

for i = 1:4
    theta = pi/2 * i;
    delta = pi/4 * i;
    shock_derivative(theta, M) - ((shock_residual(delta, M, theta + h) - shock_residual(delta, M, theta)) / h)
end
